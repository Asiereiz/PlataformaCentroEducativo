<% const datos = locals.datos || {}; %>
<%- include('partials/header', { migas: [{ texto: "Contacto", href: "/contacto" }] }) %>

        <main>
<%- include('partials/mensajes') %>
            <section id="loggear">
                <form id="formcontacto" action="/contacto" method="post">
                    <legend>Contáctanos</legend>
                    <fieldset>
                        <label for="Correo">Correo electrónico: <input type="email" id="Correo" name="correo" value="<%= datos.correo || '' %>" required placeholder="Inserta tu correo electrónico"></label>
                        <label for="mensaje_contacto">Mensaje: <textarea id="mensaje_contacto" name="mensaje_contacto" required placeholder="Escribe el mensaje" rows="10" cols="100"><%= datos.mensaje_contacto || '' %></textarea></label>
                        <button type="submit"> Enviar</button>
                    </fieldset>
                </form>
            </section>
        </main>

<%- include('partials/footer') %>
