<%- include('partials/header', { migas: [{ texto: "Mis matrículas", href: "/mis-matriculas" }] }) %>

        <main>
<%- include('partials/mensajes') %>
            <section id="ver_matriculas">
                <h3>Mis matrículas</h3>
                <div id="ver_mis_matriculas">
<% if (matriculas.length === 0) { %>
                    No tienes matrículas.
<% } %>
<% matriculas.forEach(m => { %>
                    <article>
                        <p>Curso: <%= m.curso_nombre %></p>
                        <p>Descripción: <%= m.curso_descripcion %></p>
                        <p>Fecha de matrícula: <%= m.fecha_matricula %></p>
                    </article>
<% }) %>
                </div>
            </section>

            <section id="matricularme">
                <h3>Matricularme</h3>
                <form id="matricularme_form" method="post" action="/mis-matriculas" data-confirmar="¿Estás seguro de que quieres matricularte en {opcion}?">
                    <label for="curso_matricula">Selecciona un curso:</label>
                    <select id="curso_matricula" name="curso" required>
                        <option value="" disabled selected>Selecciona un curso</option>
<% cursos.forEach(c => { %>
                        <option value="<%= c.id %>"><%= c.nombre %></option>
<% }) %>
                    </select>
                    <button type="submit">Matricularme</button>
                </form>
            </section>

            <section id="cancelar_matricula">
                <h3>Cancelar matrícula</h3>
                <div id="cancelar_matricula">
                    <form id="cancelarmat_form" method="post" action="/mis-matriculas/cancelar" data-confirmar="¿Seguro que quieres cancelar la matrícula en {opcion}?">
                        <label for="cancelarmat_select">Selecciona un curso:</label>
                        <select id="cancelarmat_select" name="matricula" required>
                            <option value="" disabled selected>Selecciona una matrícula</option>
<% matriculas.forEach(m => { %>
                            <option value="<%= m.id %>"><%= m.curso_nombre %></option>
<% }) %>
                        </select>
                        <button type="submit">Cancelar matrícula</button>
                    </form>
                </div>
            </section>
        </main>

<%- include('partials/footer', { scripts: ["/js/formularios.js"] }) %>
