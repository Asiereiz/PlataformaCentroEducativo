<%
  /* Un campo de formulario (input, textarea o select).
     Recibe: c (la definición del campo), forma ("alta" o "mod") y, a través de
     locals, g (la configuración de la página) y datos/formulario (para conservar
     lo que escribió el usuario si el servidor devuelve errores). */
  const datos = locals.datos || {};
  const id = `${c.n}_${forma}_${g.clave}`;
  const v = (locals.formulario === forma && datos[c.n] !== undefined) ? datos[c.n] : "";
  const requerido = c.tipo !== "file" && !(forma === "mod" && c.opcionalAlModificar);
  const llenar = forma === "mod" && c.tipo !== "file"; // el JS rellena estos campos al elegir un ID
  const opciones = c.tipo === "estado"
    ? [{ valor: "activo", texto: "Activo" }, { valor: "inactivo", texto: "Inactivo" }]
    : (c.opciones || []);
%>
<% if (c.tipo === "textarea") { %><textarea id="<%= id %>" name="<%= c.n %>" rows="5" cols="50"<%= requerido ? " required" : "" %><% if (llenar) { %> data-campo="<%= c.n %>"<% } %> placeholder="<%= c.ph %>"><%= v %></textarea><%
 } else if (c.tipo === "select" || c.tipo === "estado") { %><select id="<%= id %>" name="<%= c.n %>"<%= requerido ? " required" : "" %><% if (llenar) { %> data-campo="<%= c.n %>"<% } %>>
                        <option value="" disabled<%= v === "" ? " selected" : "" %>><%= c.tipo === "estado" ? "Selecciona un estado" : c.ph %></option>
<% opciones.forEach(o => { %>
                        <option value="<%= o.valor %>"<%= String(v) === String(o.valor) ? " selected" : "" %>><%= o.texto %></option>
<% }) %>
                    </select><%
 } else if (c.tipo === "file") { %><input type="file" id="<%= id %>" name="<%= c.n %>" accept="image/jpeg,image/png,image/webp"><%
 } else { %><input type="<%= c.tipo %>" id="<%= id %>" name="<%= c.n %>" value="<%= v %>"<%= requerido ? " required" : "" %><% if (llenar) { %> data-campo="<%= c.n %>"<% } %> placeholder="<%= c.ph %>"><% } %>
