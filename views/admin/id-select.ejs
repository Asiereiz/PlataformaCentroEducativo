<%
  /* Desplegable de identificadores. forma = "mod", "del" o "info". */
  const datos = locals.datos || {};
  const elegido = locals.formulario === forma ? String(datos.id || "") : "";
%>
<select id="id_<%= forma %>_<%= g.clave %>" name="id" required>
                            <option value=""<%= elegido === "" ? " selected" : "" %>> Selecciona un ID </option>
<% g.ids.forEach(o => { %>
                            <option value="<%= o.valor %>"<%= elegido === String(o.valor) ? " selected" : "" %>><%= o.texto %></option>
<% }) %>
                        </select>
