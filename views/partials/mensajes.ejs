<%# Mensaje de aviso (flash) y lista de errores de validación (tema 5.2, apartado 5) %>
<% if (locals.mensaje) { %>
            <p class="aviso aviso-<%= mensaje.tipo %>" role="status"><%= mensaje.texto %></p>
<% } %>
<% if (locals.errores && errores.length > 0) { %>
            <div class="aviso aviso-error" role="alert">
                <ul>
<% errores.forEach(error => { %>
                    <li><%= error %></li>
<% }) %>
                </ul>
            </div>
<% } %>
