<%
  const privado = Boolean(locals.usuario) && locals.variante !== "publico";
  const admin = privado && usuario.rol === "admin";
%>
        <footer class="footer-contacto<%= admin ? ' footer-admin' : '' %>">
            <h3>Estamos aquí para ayudarte</h3>
            <p class="footer-contacto-intro">
                Si tienes alguna consulta sobre nuestros cursos, matrículas o servicios, puedes ponerte en contacto
                con nuestro equipo. Estaremos encantados de atenderte.
            </p>
            <div class="footer-contacto-tarjetas">
                <article>
                    <h4>Correo electrónico</h4>
                    <p><a href="mailto:info@centroeducativo.com">info@centroeducativo.com</a></p>
                </article>
                <article>
                    <h4>Teléfono</h4>
                    <p>+34 000 000 000</p>
                </article>
                <article>
                    <h4>Dirección</h4>
                    <p>Dirección del centro educativo</p>
                </article>
                <article>
                    <h4>Horario de atención</h4>
                    <p>Lunes a viernes: 09:00 - 14:00</p>
                </article>
            </div>
<% if (privado) { %>
            <p class="footer-contacto-enlace">Contacta con nosotros haciendo click <a href="/contacto">aquí.</a></p>
<% } else { %>
            <p class="footer-contacto-enlace">Contacta con nosotros una vez hayas iniciado sesión.</p>
<% } %>
        </footer>

<% (locals.scripts || []).forEach(script => { %>
        <script src="<%= script %>"></script>
<% }) %>
    </body>

</html>
