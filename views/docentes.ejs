<%- include('partials/header', { migas: [{ texto: "Docentes", href: "/docentes" }] }) %>

        <main class="main_docentes">
<%- include('partials/mensajes') %>
            <h3>Docentes</h3>
            <!-- Esta página se genera en el servidor: la ruta consulta MariaDB y res.render() rellena la vista -->
            <div id="lista_docentes">
<% if (docentes.length === 0) { %>
                No hay docentes disponibles.
<% } %>
<% docentes.forEach(d => { %>
                <article>
                    <img class="imagen-tarjeta" src="<%= d.fotografia %>" alt="Fotografía de <%= d.nombre %>" loading="lazy">
                    <h4><%= d.nombre %></h4>
                    <p>Nombre: <%= d.nombre %></p>
                    <p>Primer apellido: <%= d.primer_apellido %></p>
                    <p>Segundo apellido: <%= d.segundo_apellido %></p>
                    <p>Correo: <%= d.correo %></p>
                    <p>Teléfono: <%= d.telefono %></p>
                    <p>Especialidad: <%= d.especialidad %></p>
                    <p>Estado: <%= d.estado %></p>
                </article>
<% }) %>
            </div>
        </main>

<%- include('partials/footer') %>
