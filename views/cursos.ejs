<%- include('partials/header', { migas: [{ texto: "Cursos", href: "/cursos" }] }) %>

        <main class="main_cursos">
<%- include('partials/mensajes') %>
            <section id="catalogo">
                <h3>Catálogo de cursos</h3>
                <div id="lista_cursos"></div>
                <details id="json_cursos">
                    <summary>Respuesta JSON de GET /api/cursos</summary>
                    <pre id="json_cursos_texto"></pre>
                </details>
            </section>

            <section id="buscar_cursos">
                <h3>Buscar cursos</h3>
                <label for="busqueda_curso">Nombre:</label>
                <input type="search" id="busqueda_curso" placeholder="Escribe para buscar">
                <div id="resultados_busqueda" aria-live="polite"></div>
            </section>

            <section id="info_curso">
                <h3>Información del curso</h3>
                <label for="detalles_curso">Nombre:</label>
                <input type="search" id="detalles_curso" placeholder="Escribe para buscar">
                <div id="detalles_busqueda" aria-live="polite"></div>
            </section>

            <section id="historial">
                <h3>Historial</h3>
                <div id="historial_cursos"></div>
            </section>
        </main>

<%- include('partials/footer', { scripts: ["/js/cursos.js"] }) %>
